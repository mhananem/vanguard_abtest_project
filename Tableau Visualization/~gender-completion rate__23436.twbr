      <aliases enabled='yes' />
      <column caption='Age group' datatype='string' name='[Calculation_2162257860935684]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [client_age] &gt;= 18 AND [client_age] &lt;= 34 THEN &quot;Young&quot;&#13;&#10;&#13;&#10;ELSEIF [client_age] &gt; 34 AND [client_age] &lt;= 48 THEN &quot;Middle&quot;&#13;&#10;&#13;&#10;ELSEIF [client_age] &gt; 48 AND [client_age] &lt;= 60 THEN &quot;Senior&quot;&#13;&#10;&#13;&#10;ELSE &quot;Elders&quot;&#13;&#10;END' />
      </column>
      <column caption='Completion rate' datatype='real' name='[Calculation_2162257861537797]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [process_step] = &quot;confirm&quot; THEN 1 END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;IF [process_step] = &quot;start&quot; THEN 1 END&#13;&#10;)&#13;&#10;* 100' />
      </column>
      <column caption='Tenure group' datatype='string' name='[Calculation_2162257866764294]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [client_tenure_yr] &lt;= 5 THEN &quot;New&quot;&#13;&#10;&#13;&#10;ELSEIF [client_tenure_yr] &lt;= 10 THEN &quot;Mid&quot;&#13;&#10;&#13;&#10;ELSE &quot;Long&quot;&#13;&#10;END' />
      </column>
