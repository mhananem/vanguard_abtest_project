    <worksheet name='gender completion rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Gender Vs Completion rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='demo_exp_merged+' name='federated.1k0vf2b002z580144496u1tf8cm4' />
          </datasources>
          <datasource-dependencies datasource='federated.1k0vf2b002z580144496u1tf8cm4'>
            <column caption='Completion rate' datatype='real' name='[Calculation_2162257861537797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [process_step] = &quot;confirm&quot; THEN 1 END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;IF [process_step] = &quot;start&quot; THEN 1 END&#13;&#10;)&#13;&#10;* 100' />
            </column>
            <column caption='Gender' datatype='string' name='[gender]' role='dimension' type='nominal' />
            <column-instance column='[gender]' derivation='None' name='[none:gender:nk]' pivot='key' type='nominal' />
            <column-instance column='[variation]' derivation='None' name='[none:variation:nk]' pivot='key' type='nominal' />
            <column caption='Process Step' datatype='string' name='[process_step]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2162257861537797]' derivation='User' name='[usr:Calculation_2162257861537797:qk]' pivot='key' type='quantitative' />
            <column caption='Variation' datatype='string' name='[variation]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1k0vf2b002z580144496u1tf8cm4].[none:gender:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:gender:nk]' member='&quot;Female&quot;' />
              <groupfilter function='member' level='[none:gender:nk]' member='&quot;Male&quot;' />
              <groupfilter function='member' level='[none:gender:nk]' member='&quot;Unknown&quot;' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.1k0vf2b002z580144496u1tf8cm4].[none:variation:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:variation:nk]' member='&quot;Control&quot;' />
              <groupfilter function='member' level='[none:variation:nk]' member='&quot;Test&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.1k0vf2b002z580144496u1tf8cm4].[none:gender:nk]</column>
            <column>[federated.1k0vf2b002z580144496u1tf8cm4].[none:variation:nk]</column>
          </slices>
          <aggregation value='true' />
