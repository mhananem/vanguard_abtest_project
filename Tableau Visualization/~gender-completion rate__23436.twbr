      <column caption='Completion rate' datatype='real' name='[Calculation_2162257469304832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([client_id]) / TOTAL(COUNT([client_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Conv Rate Label' datatype='string' name='[Calculation_2162257476878337]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND(COUNT([client_id]) / TOTAL(COUNT([client_id])) * 100, 1)) + &quot;%&quot;'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Completion  rate Pct' datatype='real' name='[Calculation_2162257480040450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(COUNT([client_id]) / TOTAL(COUNT([client_id]))) * 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Tenure Conversion rate' datatype='real' name='[Calculation_2162257483108355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([client_id]) / TOTAL(COUNT([client_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='age_group_calculated' datatype='string' name='[Calculation_5856134805913603]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [client_age] &gt;= 17 AND [client_age] &lt; 34 THEN &quot;Young&quot;&#10;ELSEIF [client_age] &gt;= 34 AND [client_age] &lt; 48 THEN &quot;Middle&quot;&#10;ELSEIF [client_age] &gt;= 48 AND [client_age] &lt; 60 THEN &quot;Senior&quot;&#10;ELSEIF [client_age] &gt;= 60 THEN &quot;Elder&quot;&#10;END' />
      </column>
      <column caption='Tenure_group_calculated' datatype='string' name='[Calculation_5856134808055814]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [client_tenure_yr] &gt;= 0 AND [client_tenure_yr] &lt; 5 THEN &quot;New&quot;&#10;ELSEIF [client_tenure_yr]&gt;= 5 AND [client_tenure_yr] &lt; 10 THEN &quot;Mid&quot;&#10;ELSEIF [client_tenure_yr] &gt;= 10 THEN &quot;Long&quot;&#10;ELSE &quot;Unknown&quot;&#10;END' />
      </column>
